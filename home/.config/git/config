[init]
    ; default to 'main' as a branch name
    defaultBranch = main

[credential]
    ; Cache credentials for 1hr
    helper = cache --timeout 3600

[diff]
    ; Make word-diff behave how I'd like it to
    wordRegex = [-a-zA-Z0-9_$]+|.

[merge]
    ; Include original text in conflicts
    conflictStyle = zdiff3

[user]
    ; Don't guess user.name and user.email
    useConfigOnly = true

[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    ; Include github specific configuration
    ; (specifically my name and email)
    ; only in github repositories
    path = github-specific-config

[include]
    ; Include private config (not synced to github)
    ; e.g. personal/work usernames, emails, and other settings
    path = secret-config
