# custom aerc styleset -- heavily modified from the built-in "dracula"

*.default=true
*.normal=true

border.fg=#FF44AA
title.bg=#FF44AA

title.fg=#000000
title.bold=true

header.bold=true
header.fg=#FF44AA

tab.selected.fg=#000000
tab.selected.bg=#FF44AA
tab.selected.bold=false
dirlist*.bg=#000000
dirlist*.fg=#FFFFFF
dirlist*.selected.bg=#000000
dirlist*.selected.fg=#FF44AA
dirlist*.selected.bold=false
dirlist*.selected.italic=false

*error.bold=true
*error.fg=red # TODO
*warning.fg=yellow # TODO
*success.fg=green # TODO

statusline_default.bg=#333333
statusline_error.fg=red # TODO

msglist_*.fg=#AAAAAA
msglist_unread.fg=#FFFFFF
msglist_deleted.fg=#666666
msglist_*.selected.bg=#000000
msglist_*.selected.fg=#FF44AA
msglist_result.fg=#DD77DD
msglist_marked*.reverse=true

msglist_pill.bg=#FFFFFF
msglist_pill.fg=#000000

part_*.fg=#FFFFFF
part_mimetype.fg=#DD77DD
part_*.selected.fg=#FFFFFF
part_*.selected.bg=#DD77DD
part_filename.selected.bold=true

completion_pill.reverse=false
selector_default.fg=orange
selector_focused.bold=false
selector_focused.bg=#000000
selector_focused.fg=#FF44AA
selector_chooser.bold=false
selector_chooser.bg=#000000
selector_chooser.fg=#FF44AA
default.selected.bold=false
default.selected.fg=#FF44AA
default.selected.bg=#000000

[viewer]
*.default=true
*.normal=true
url.underline=true
header.bold=true
signature.dim=true
diff_meta.bold=true
diff_chunk.dim=true
diff_add.fg=2
diff_del.fg=1
diff_whitespace.bg=1
quote_*.fg=6
quote_*.dim=true
quote_1.dim=false
code.fg=4
